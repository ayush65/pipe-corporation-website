# Canonical origin for metadata, sitemap.xml, robots.txt and JSON-LD.
# Set this to the production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://www.pipecorporation.in

# ---------------------------------------------------------------------------
# Enquiry email delivery
# ---------------------------------------------------------------------------
# The enquiry form (popup + contact page) emails every submission to
# RECIPIENT_EMAIL. Two providers are supported, tried in this order:
#
#   1. SMTP  — set SMTP_HOST + SMTP_USER + SMTP_PASS
#   2. Resend — set RESEND_API_KEY (used as a fallback if SMTP is down)
#
# With neither configured the form hands the enquiry to WhatsApp instead,
# so a lead is never lost.

# --- SMTP (Gmail, Zoho, your own mail server) -------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail requires an App Password here, not the account password.
SMTP_PASS=

# --- Sender identity --------------------------------------------------------
# Shown in the recipient's inbox. Gmail only accepts a From address that
# matches the authenticated account, so this is usually the SMTP user.
EMAIL=
EMAIL_NAME=Pipe Corporation

# --- Recipient --------------------------------------------------------------
# Where enquiries are delivered. Comma-separate for more than one inbox.
RECIPIENT_EMAIL=pipecorporation79@gmail.com

# --- Resend (optional fallback) ---------------------------------------------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# ENQUIRY_FROM_EMAIL=Pipe Corporation <enquiries@yourdomain.com>
