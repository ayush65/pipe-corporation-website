# Canonical origin for metadata, sitemap.xml, robots.txt and JSON-LD.
# Set this to the production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://www.pipecorporation.in

# Resend API key used to deliver website enquiries by email.
# Create one at https://resend.com/api-keys and add it to the Vercel
# project under Settings -> Environment Variables.
# Without it the enquiry form falls back to handing the enquiry to WhatsApp,
# so no lead is ever lost.
RESEND_API_KEY=

# Optional overrides for the enquiry email.
# ENQUIRY_TO_EMAIL=pipecorporation79@gmail.com
# ENQUIRY_FROM_EMAIL=Pipe Corporation <enquiries@yourdomain.com>
